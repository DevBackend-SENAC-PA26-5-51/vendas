DATABASE_URL="mysql://vendas:<password>@db:3306/vendas"

# Aplicação
APP_NAME=vendas_api
APP_PORT=5001
NODE_ENV=production
CORS_ORIGIN=*

# Banco de dados
DB_PORT=4406
DB_INTERNAL_PORT=3306
DB_NAME=vendas
DB_USER=vendas
DB_PASSWORD=<password>
DB_ROOT_PASSWORD=<password>

# Imagem do banco
MARIADB_IMAGE=mariadb:11.4

# Persistência
DB_VOLUME=mariadb_data

#Ativar o Swagger (documentação da API)
ENABLE_SWAGGER=true