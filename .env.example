# Porta da aplicação
PORT=5000

# String de conexão do banco de dados (MariaDB / MySQL)
# Para executar via Docker Compose (comunicando com o container 'db'):
DATABASE_URL="mysql://vendas:@db:3306/vendas"

# Para executar localmente fora do Docker (comunicando com o banco na sua máquina):
# DATABASE_URL="mysql://root:root@localhost:3306/vendas"

# Configurações do Docker Compose

# Aplicação
APP_NAME=vendas_api
APP_PORT=5000
NODE_ENV=production

# Banco de dados
DB_HOST=db
DB_PORT=3306
DB_NAME=vendas
DB_USER=vendas
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Imagem do banco
MARIADB_IMAGE=mariadb:11.4

# Persistência
DB_VOLUME=mariadb_data